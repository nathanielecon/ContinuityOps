% mathdocs.sty — shared style for the corrected 7th-grade math document set.
% Matches the typography of the original PDFs (article, 11pt, Computer Modern,
% bold run-in headings, plain centered folio) while fixing spacing defects.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathdocs}[2026/08/05 Corrected math worksheet style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{amsmath,amssymb,amsfonts}
\RequirePackage{microtype}
\RequirePackage{enumitem}
\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{array}
\RequirePackage{needspace}
\RequirePackage{xspace}
\usetikzlibrary{arrows.meta,positioning,calc}

% ---------------------------------------------------------------- headings --
% Lesson banner, e.g. "Topic 1-1 Relate Integers and Opposites".
\newcommand{\lesson}[1]{%
  \needspace{4\baselineskip}%
  \bigskip\par\noindent{\Large\bfseries #1}\par\medskip\noindent\ignorespaces}

% Question banner, e.g. "Question 1".
\newcommand{\question}[1]{%
  \needspace{3\baselineskip}%
  \medskip\par\noindent{\large\bfseries #1}\par\smallskip\noindent\ignorespaces}

% Bold block heading on its own line ("Question", "Important words",
% "Work the problem one tiny step at a time", "Why this makes sense").
% Trailing \noindent keeps the following paragraph flush left, matching the
% originals; without it LaTeX indents the first line after the heading.
\newcommand{\blockhead}[1]{%
  \needspace{2\baselineskip}%
  \par\vspace{0.6\baselineskip}\noindent\textbf{#1}%
  \par\nobreak\vspace{0.2\baselineskip}\noindent\ignorespaces}

% Run-in bold label followed by text. The trailing space is explicit so the
% label never fuses with the sentence that follows it.
\newcommand{\runin}[1]{\textbf{#1}\ }

\newcommand{\checked}[1]{\par\noindent\runin{Checked answer:}#1\par}
\newcommand{\finalans}[1]{\par\noindent\runin{Final answer:}#1\par}

% ------------------------------------------------------------------- lists --
\newlist{words}{itemize}{1}
\setlist[words]{leftmargin=2.2em,itemsep=0.35\baselineskip,topsep=0.4\baselineskip,label=\textbullet}

\newlist{steps}{enumerate}{1}
\setlist[steps]{leftmargin=2.2em,itemsep=0.35\baselineskip,topsep=0.4\baselineskip,label=\arabic*.}

% Vocabulary term: italic term, guaranteed space before the definition.
% \xspace supplies the space before a word but suppresses it before punctuation,
% so both "\term{Nonzero}means" and "\term{cancel}, which" set correctly.
\newcommand{\term}[1]{\textit{#1}\xspace}

% -------------------------------------------------------------- math atoms --
% Absolute value with visible interior space when shown as a bare symbol pair,
% so "written | |" does not collapse to "||".
\newcommand{\barsym}{\ensuremath{\lvert\;\rvert}}
\newcommand{\abs}[1]{\ensuremath{\left\lvert #1 \right\rvert}}
% Mixed number: unambiguous whole-plus-fraction, e.g. \mixed{15}{1}{2}.
\newcommand{\mixed}[3]{\ensuremath{#1\tfrac{#2}{#3}}}
\newcommand{\degF}{\ensuremath{^{\circ}\mathrm{F}}}
\newcommand{\degC}{\ensuremath{^{\circ}\mathrm{C}}}
% Money: keeps the dollar sign glued to its amount with a normal preceding space.
\newcommand{\money}[1]{\ensuremath{\$#1}}

% ----------------------------------------------------------- answer blanks --
% Answer blank. Always leaves a real space before any trailing format hint, so
% a line never reads as "= (decimal)" with the hint in the answer position.
\newcommand{\blank}[1][2.2cm]{\underline{\hspace{#1}}}
% Format hint that follows an answer blank, e.g. \hint{decimal}.
\newcommand{\hint}[1]{\ (#1)}
% Worksheet item answer slot: blank plus optional trailing unit/hint.
\newcommand{\ansblank}[1][2.2cm]{\ \blank[#1]}

% ------------------------------------------------------------- number line --
% Blank number line for the student to mark on.
% \blanknumline{min}{max}{step}
\newcommand{\blanknumline}[3]{%
  \begin{center}
  \begin{tikzpicture}[x=0.62cm,y=0.62cm]
    \draw[{Stealth[length=2.4mm]}-{Stealth[length=2.4mm]}] (#1-0.7,0) -- (#2+0.7,0);
    \foreach \x in {#1,\the\numexpr#1+#3\relax,...,#2}{%
      \draw (\x,0.16) -- (\x,-0.16);
      \node[below=1pt,font=\footnotesize] at (\x,-0.16) {$\x$};}
  \end{tikzpicture}
  \end{center}}

% \numberline{min}{max}{step}{marked points, comma separated}
\newcommand{\numline}[4]{%
  \begin{center}
  \begin{tikzpicture}[x=0.62cm,y=0.62cm]
    \draw[{Stealth[length=2.4mm]}-{Stealth[length=2.4mm]}] (#1-0.7,0) -- (#2+0.7,0);
    \foreach \x in {#1,\the\numexpr#1+#3\relax,...,#2}{%
      \draw (\x,0.16) -- (\x,-0.16);
      \node[below=1pt,font=\footnotesize] at (\x,-0.16) {$\x$};}
    \foreach \p in {#4}{\fill (\p,0) circle (2.4pt);}
  \end{tikzpicture}
  \end{center}}

\endinput
