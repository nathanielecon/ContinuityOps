{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "continuityops/evidence-event.schema.json",
  "title": "ContinuityOps append-only evidence event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "task_id", "candidate_sha", "produced_by", "validator_ids", "result", "artifact_sha256", "recorded_at_index"],
  "properties": {
    "event_id": { "type": "string" },
    "task_id": { "type": "string" },
    "candidate_sha": { "type": "string", "minLength": 7 },
    "produced_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "model_id"],
      "properties": {
        "role": { "type": "string" },
        "model_id": { "type": "string", "description": "ACTUAL model id, never a claimed/aspirational one" },
        "mode": { "type": "string" }
      }
    },
    "validator_ids": { "type": "array", "items": { "type": "string" } },
    "result": { "type": "string", "enum": ["pass", "fail", "not_proven", "superseded"] },
    "artifact_sha256": { "type": "string" },
    "supersedes": { "type": ["string", "null"] },
    "recorded_at_index": { "type": "integer", "minimum": 0 },
    "notes_zh": { "type": "string", "description": "Simplified Chinese free-text worker/adapter notes" }
  }
}
