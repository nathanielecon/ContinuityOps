{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "continuityops/dashboard.schema.json",
  "type": "object",
  "required": ["schema_version", "dashboard_id", "title", "panels", "owner"],
  "properties": {
    "schema_version": { "type": "string" },
    "dashboard_id": { "type": "string" },
    "title": { "type": "string" },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "metric"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "metric": { "type": "string" },
          "unit": { "type": "string" }
        }
      }
    },
    "links": { "type": "array" },
    "owner": { "type": "string" }
  }
}
